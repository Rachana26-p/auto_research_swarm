# ============================================================
# Autonomous Research Swarm — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# ------------------------------------------------------------------
# SUPABASE (per-agent least-privilege keys)
# Create these in Supabase Dashboard → Settings → API → Create new key
# Set each key's "Role" claim to: planner, discovery, extractor, validator, writer
# ------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

SUPABASE_PLANNER_KEY=
SUPABASE_DISCOVERY_KEY=
SUPABASE_EXTRACTOR_KEY=
SUPABASE_VALIDATOR_KEY=
SUPABASE_WRITER_KEY=

# ------------------------------------------------------------------
# EXTERNAL APIs (scoped to specific agents)
# ------------------------------------------------------------------
# Discovery agent only
TAVILY_API_KEY=

# Nemotron Ultra via OpenRouter (Extractor, Discovery, Writer agents)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
NEMOTRON_MODEL=

# Reasoning Models - Groq Free Tier (Planner & Validator)
GROQ_API_KEY=
GROQ_MODEL=

# Validator Alternative & Embeddings - Google Gemini Free Tier
GOOGLE_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# ------------------------------------------------------------------
# MCP DOCKER SERVERS (vibe_coding profile)
# ------------------------------------------------------------------
PLAYWRIGHT_MCP_URL=
FETCH_MCP_URL=
FILESYSTEM_MCP_URL=
MEMORY_MCP_URL=
GITHUB_MCP_URL=
GITHUB_TOKEN=

# ------------------------------------------------------------------
# APPLICATION & SECURITY SETTINGS
# ------------------------------------------------------------------
API_KEY=
BACKEND_API_KEY=
BACKEND_API_URL=
FRONTEND_URL=
KNOWLEDGE_DIR=
LANGGRAPH_CHECKPOINT_DIR=
LOG_LEVEL=
LOG_FORMAT=

# Rate limiting / budgets (per node)
EXTRACTOR_MAX_TOKENS=
EXTRACTOR_TIMEOUT_SECONDS=
DISCOVERY_MAX_RESULTS=
VALIDATOR_CONFIDENCE_THRESHOLD=