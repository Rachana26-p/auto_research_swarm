# ==============================================================================
# Autonomous Research Swarm — Frontend Production Environment Configuration
# Copy this file to .env.production or configure these in your deployment platform (e.g., Vercel, Railway, Render)
# ==============================================================================

# 1. Supabase (Must have NEXT_PUBLIC_ prefix to be accessible in browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side Supabase fallbacks
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# 2. Python Backend Connection (Point to your deployed backend domain)
# Example: https://auto-research-backend.onrender.com
BACKEND_SERVICE_URL=https://your-backend-api.onrender.com
BACKEND_API_URL=https://your-backend-api.onrender.com

# 3. Internal API Auth Key (Must match BACKEND_API_KEY in backend environment)
BACKEND_API_KEY=your-secure-internal-api-key
API_KEY=your-secure-internal-api-key
